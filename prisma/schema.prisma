generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  MANAGER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  role     Role   @default(MEMBER)

  assignedTasks Task[]
}

model Task {
  id          Int          @id @default(autoincrement())
  title       String
  description String
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)

  assigneeId Int?
  assignee   User? @relation(fields: [assigneeId], references: [id])

  project String
  dueDate DateTime?
}
